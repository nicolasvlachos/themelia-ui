# Screenshot baselines are local: `npm run screenshots` records them on first run.
tests/**/*-snapshots/
.scratch/
dist-docs
# `npm pack` output (a manual pack, or a packed-package check mid-run); never committed.
*.tgz

# The reference consumers build into these; only their source is committed.
examples/consumer-*/dist/
examples/consumer-*/dist-ssr/
examples/consumer-*/node_modules/

# The browser suites build the preview app here.
dist-test

# Generated documentation is build output: `npm run build:lib` writes it and the package ships
# it. The docs site's API tables are written when its dev server starts or a build begins.
docs/generated/
docs/build/
src/preview/generated/api/
