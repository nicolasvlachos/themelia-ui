    "dev": "vite",
    "build": "node scripts/gen-css-types.mjs && tsc -b && vite build",
    "build:lib": "node scripts/gen-css-types.mjs && node scripts/gen-barrels.mjs && tsc -b && vite build --config vite.lib.config.ts && node scripts/fix-dts-extensions.mjs && node scripts/gen-cjs-declarations.mjs && node scripts/gen-profile-manifests.mjs && node scripts/gen-dtcg-tokens.mjs && node scripts/gen-exports.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "playwright test --project=chromium --project=tailwind",
    "test:engines": "playwright test --project=firefox --project=webkit",
    "test:all": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ssr-surface": "vitest run src/lib/ssr-surface.test.tsx --pool=threads --maxWorkers=1",
    "test:tokens": "playwright test tokens",
    "test:visual": "playwright test visual",
    "test:update": "playwright test visual --update-snapshots",
    "test:contrast": "playwright test contrast",
    "test:geometry": "playwright test geometry",
    "test:a11y": "playwright test a11y",
    "test:interaction": "playwright test interaction",
    "verify": "node scripts/verify.mjs",
    "verify:gates": "node scripts/verify.mjs --gates",
    "verify:consumer": "node scripts/verify.mjs --consumer",
    "verify:release": "node scripts/release-runner.mjs",
    "prepublishOnly": "npm run verify:release -- --publish",
    "publish:without-tests": "npm publish --ignore-scripts --access public",
    "codemod": "node scripts/consumer/codemod.mjs",
    "find": "node scripts/consumer/find-component.mjs",
    "tokens:theme": "node scripts/gen-theme.mjs",
