{
  "name": "themelia-ui",
  "version": "3.1.0",
  "private": false,
  "description": "Themelia UI is a production-ready, composable React component system with CSS-first theming.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "css-modules",
    "accessibility",
    "base-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasvlachos/themelia-ui.git"
  },
  "homepage": "https://github.com/nicolasvlachos/themelia-ui#readme",
  "bugs": {
    "url": "https://github.com/nicolasvlachos/themelia-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".agents/skills/themelia-ui",
    "scripts/consumer/install-skill.mjs",
    "scripts/consumer/find-component.mjs",
    "scripts/consumer/codemod.mjs",
    "docs/README.md",
    "docs/learn",
    "docs/generated",
    "docs/build",
    "src/styles/TOKENS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui-provider": {
      "types": "./dist/lib/ui-provider/index.d.ts",
      "default": "./dist/ui-provider.js"
    },
    "./theming": {
      "types": "./dist/lib/theming/index.d.ts",
      "default": "./dist/theming.js"
    },
    "./forms": {
      "types": "./dist/lib/forms/index.d.ts",
      "default": "./dist/forms.js"
    },
    "./forms-rhf": {
      "types": "./dist/lib/forms-rhf/index.d.ts",
      "default": "./dist/forms-rhf.js"
    },
    "./primitives": {
      "types": "./dist/components/primitives/index.d.ts",
      "default": "./dist/primitives.js"
    },
    "./primitives.css": "./dist/primitives.css",
    "./base/*.css": "./dist/base/*.css",
    "./base/*": {
      "types": "./dist/components/base/*/index.d.ts",
      "default": "./dist/base/*.js"
    },
    "./layout/*.css": "./dist/layout/*.css",
    "./layout/*": {
      "types": "./dist/components/layout/*/index.d.ts",
      "default": "./dist/layout/*.js"
    },
    "./features/*.css": "./dist/features/*.css",
    "./features/*": {
      "types": "./dist/components/features/*/index.d.ts",
      "default": "./dist/features/*.js"
    },
    "./blocks/*.css": "./dist/blocks/*.css",
    "./blocks/*": {
      "types": "./dist/components/blocks/*/index.d.ts",
      "default": "./dist/blocks/*.js"
    },
    "./style.css": "./dist/style.css",
    "./core.css": "./dist/core.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./styles/*": "./dist/styles/*",
    "./profiles/*.json": "./dist/profiles/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-css-types.mjs && tsc -b && vite build",
    "build:lib": "node scripts/gen-css-types.mjs && node scripts/gen-barrels.mjs && tsc -b && vite build --config vite.lib.config.ts && node scripts/fix-dts-extensions.mjs && node scripts/gen-profile-manifests.mjs && node scripts/gen-dtcg-tokens.mjs && node scripts/gen-migration-map.mjs && node scripts/gen-consumer-docs.mjs && node scripts/gen-composition-ladder.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "playwright test --project=chromium --project=tailwind",
    "test:engines": "playwright test --project=firefox --project=webkit",
    "test:all": "playwright test --project=chromium --project=tailwind --project=firefox --project=webkit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ssr-surface": "vitest run src/lib/ssr-surface.test.tsx --pool=threads --maxWorkers=1",
    "screenshots": "playwright test --project=visual",
    "audit": "playwright test --project=audit",
    "verify": "node scripts/verify.mjs",
    "verify:gates": "node scripts/verify.mjs --gates",
    "verify:consumer": "node scripts/verify.mjs --consumer",
    "verify:release": "node scripts/release-runner.mjs",
    "prepublishOnly": "npm run verify:release -- --publish",
    "publish:without-tests": "npm publish --ignore-scripts --access public",
    "codemod": "node scripts/consumer/codemod.mjs",
    "find": "node scripts/consumer/find-component.mjs",
    "tokens:theme": "node scripts/gen-token-names.mjs",
    "tokens:tailwind": "node scripts/gen-tailwind-bridge.mjs",
    "tokens:surface": "node scripts/lib/token-surface.mjs --write",
    "gen:architecture": "node scripts/gen-architecture-manifest.mjs && node scripts/gen-migration-map.mjs",
    "docs:sync-skill": "npm run build:lib && node scripts/verify-api-snapshot.mjs && node scripts/gen-gallery.mjs && node scripts/gen-agent-skill.mjs && node scripts/gen-test-docs.mjs && node scripts/gen-status-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react-resizable-panels": "^4.12.3"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.2.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.0",
    "leaflet-draw": "^1.0.4",
    "leaflet.fullscreen": "^5.0.0",
    "leaflet.markercluster": "^1.5.0",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20",
    "react-hook-form": "^7.86.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "recharts": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "leaflet-draw": {
      "optional": true
    },
    "leaflet.fullscreen": {
      "optional": true
    },
    "leaflet.markercluster": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "react-leaflet-markercluster": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/culori": "^4.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.markercluster": "^1.5.3",
    "lightningcss": "1.32.0",
    "oxlint": "^1.79.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
